    {
        "id": "8b6d79adad3ddc86",
        "type": "function",
        "z": "5ffc6524f94b2cf6",
        "name": "jsonify_seuil()",
        "func": "// On récupère la valeur qui vient de changer\nlet valeur = msg.payload;\n\n// On initialise l'objet de sortie\nlet update = {};\n\n// On construit l'objet selon le topic (ex: \"ht\" ou \"lt\")\n// On utilise msg.topic pour savoir quelle clé créer\nif (msg.topic === \"regul_ht\") {\n    update = { regul: { ht: valeur } };\n}\nelse if (msg.topic === \"regul_lt\") {\n    update = { regul: { lt: valeur } };\n}\n\n// On remplace le payload original par notre objet structuré\nmsg.payload = update;\n\nreturn msg;\n\n//delay\nnode.status({ fill: \"blue\", shape: \"dot\", text: \"envoi...\" });\nsetTimeout(() => {\n    node.send(msg);\n    node.status({});\n}, 100);\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1120,
        "y": 840,
        "wires": [
            [
                "9b40a3b25ddd1090",
                "1124147b9f83735a"
            ]
        ]
