        "name": "extract_fanspeed()",
        "func": "// On récupère la valeur brute (0-255)\nlet rawSpeed = msg.payload.status.fanspeed;\n\n// On convertit en pourcentage pour que ce soit plus \"humain\"\nlet percent = Math.round((rawSpeed / 255) * 100);\n\n// On prépare le message pour le Dashboard\nmsg.payload = percent;\nmsg.topic = \"Vitesse Ventilateur\"; // Optionnel : donne un titre au graphique\nconsole.log(\"fanspeed:\"+String(msg.payload));\nreturn msg;",
